---
import type { Locale } from '../i18n/ui';
import { LOCALES, translations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
const currentLocaleObj = LOCALES.find((l) => l.code === locale) || LOCALES[0];
const homeUrl = locale === 'en' ? '/' : `/${locale}/`;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#FFFDF7]/85 dark:bg-[#151614]/85 border-b border-vt-rose/20 dark:border-slate-800/80 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href={homeUrl} class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-vt-rose rounded-lg">
      <div class="relative w-9 h-9 rounded-xl bg-slate-900 dark:bg-slate-800 flex items-center justify-center p-1.5 shadow-sm group-hover:scale-105 transition-transform border border-vt-rose/30">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-full h-full" fill="none">
          <line x1="8" y1="16" x2="8" y2="16" stroke="#D8A2A2" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="12" y1="11" x2="12" y2="21" stroke="#8EA66B" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="16" y1="7" x2="16" y2="25" stroke="#D8A2A2" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="20" y1="11" x2="20" y2="21" stroke="#8EA66B" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="24" y1="14" x2="24" y2="18" stroke="#FFDCDC" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="text-xl font-black tracking-tight text-slate-900 dark:text-white">
        Voice<span class="text-vt-rose">Take</span>
      </span>
      <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-vt-blush/80 text-slate-800 dark:bg-vt-rose/25 dark:text-vt-cream border border-vt-rose/40">
        Studio
      </span>
    </a>

    <!-- Navigation Anchor Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href="#features" class="hover:text-vt-sage dark:hover:text-vt-cream transition-colors">{t.nav.features}</a>
      <a href="#specs" class="hover:text-vt-sage dark:hover:text-vt-cream transition-colors">{t.nav.specs}</a>
      <a href="#faq" class="hover:text-vt-sage dark:hover:text-vt-cream transition-colors">{t.nav.faq}</a>
    </nav>

    <!-- Actions: Language Select, Theme Switcher, Support CTA -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Language Dropdown -->
      <div class="relative" id="lang-dropdown-wrapper">
        <button
          type="button"
          id="lang-dropdown-btn"
          aria-haspopup="true"
          aria-expanded="false"
          class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 bg-vt-cream/60 dark:bg-slate-800/80 hover:bg-vt-blush/60 dark:hover:bg-slate-700 rounded-xl border border-vt-rose/20 dark:border-slate-700 transition-colors cursor-pointer"
        >
          <span class="text-base">{currentLocaleObj.flag}</span>
          <span class="hidden sm:inline">{currentLocaleObj.nativeName}</span>
          <svg class="w-3.5 h-3.5 opacity-60 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="lang-dropdown-menu"
          class="hidden absolute right-0 mt-2 w-42 bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-vt-rose/20 dark:border-slate-700 py-1.5 z-50"
        >
          {LOCALES.map((l) => {
            const targetUrl = l.code === 'en' ? '/' : `/${l.code}/`;
            const isCurrent = l.code === locale;
            return (
              <a
                href={targetUrl}
                class={`flex items-center justify-between px-3.5 py-2 text-xs sm:text-sm transition-colors ${
                  isCurrent
                    ? 'font-bold text-slate-900 dark:text-white bg-vt-blush/60 dark:bg-vt-rose/20'
                    : 'text-slate-700 dark:text-slate-300 hover:bg-vt-cream/50 dark:hover:bg-slate-700'
                }`}
              >
                <span class="flex items-center gap-2">
                  <span>{l.flag}</span>
                  <span>{l.nativeName}</span>
                </span>
                {isCurrent && <span class="text-xs text-vt-sage font-bold">✓</span>}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Light / Dark Theme Switcher Button -->
      <button
        type="button"
        id="theme-toggle-btn"
        aria-label="Toggle Light/Dark Theme"
        class="p-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white bg-vt-cream/60 dark:bg-slate-800/80 hover:bg-vt-blush/60 dark:hover:bg-slate-700 border border-vt-rose/20 dark:border-slate-700 rounded-xl transition-colors cursor-pointer"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg class="w-4 h-4 hidden dark:block text-vt-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg class="w-4 h-4 block dark:hidden text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Support Developer CTA -->
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        title={t.nav.supportTitle}
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-vt-sage hover:bg-vt-sage-hover text-white font-bold text-xs sm:text-sm shadow-sm shadow-vt-sage/20 transition-all transform hover:scale-102 cursor-pointer focus:outline-none focus:ring-2 focus:ring-vt-sage"
      >
        <span class="text-sm">☕</span>
        <span class="hidden sm:inline">{t.nav.support}</span>
        <span class="sm:hidden">Coffee</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Language Dropdown Interactivity
  const langBtn = document.getElementById('lang-dropdown-btn');
  const langMenu = document.getElementById('lang-dropdown-menu');

  if (langBtn && langMenu) {
    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = langBtn.getAttribute('aria-expanded') === 'true';
      langBtn.setAttribute('aria-expanded', String(!isExpanded));
      langMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!langMenu.classList.contains('hidden')) {
        langMenu.classList.add('hidden');
        langBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Theme Toggle Interactivity
  const themeToggle = document.getElementById('theme-toggle-btn');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('voicetake_theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('voicetake_theme', 'dark');
      }
    });
  }
</script>
