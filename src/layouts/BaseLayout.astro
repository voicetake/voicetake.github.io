---
import '../styles/global.css';
import type { Locale } from '../i18n/ui';
import ThemeScript from '../components/ThemeScript.astro';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  locale: Locale;
  canonicalUrl?: string;
}

const { locale, canonicalUrl } = Astro.props;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <ThemeScript />
    <SEOHead locale={locale} canonicalUrl={canonicalUrl} />
  </head>
  <body class="min-h-screen flex flex-col bg-[#FFFDF7] dark:bg-[#151614] text-slate-900 dark:text-slate-100 antialiased selection:bg-vt-rose selection:text-white transition-colors duration-200">
    <Header locale={locale} />
    <main class="flex-1 flex flex-col">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
